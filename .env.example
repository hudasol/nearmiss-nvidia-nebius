# NearMiss configuration. Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (https://tokenfactory.nebius.com/ -> API keys). Server-side only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NVIDIA open model used for incident interpretation and intervention candidates.
# Checked against the live /v1/models list at runtime; falls back to another NVIDIA Nemotron model.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_S=60
NEBIUS_MAX_RETRIES=2

# Local persistence (SQLite file) and API server
NEARMISS_DB_PATH=var/nearmiss.sqlite3
NEARMISS_HOST=127.0.0.1
NEARMISS_PORT=8000
# Worker processes for simulation batches (0 = run in the API process)
NEARMISS_WORKERS=4
